{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["./*.js", "./*.d.ts"]
}
